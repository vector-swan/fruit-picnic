{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'no install needed'",
  "buildCommand": "node scripts/build-www.mjs --web",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(index.html|)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
